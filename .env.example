# Publieke RevenueCat SDK-sleutels. Deze sleutels mogen in de mobiele app staan.
# Gebruik de Test Store-sleutel alleen in development; nooit in een storebuild.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_test_store_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_public_sdk_key

# OPENAI_API_KEY, REVENUECAT_SECRET_KEY en REVENUECAT_WEBHOOK_SECRET
# horen uitsluitend in Firebase Secret Manager, nooit in een EXPO_PUBLIC variabele.
